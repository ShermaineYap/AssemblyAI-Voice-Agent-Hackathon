# Copy to .env and fill in. .env is gitignored and never reaches the browser.
# https://www.assemblyai.com/dashboard/api-keys
ASSEMBLYAI_API_KEY=

# Optional
# PORT=3000
# PUBLIC_ORIGIN=https://your-app.onrender.com   # only this origin may mint tokens
# TOKENS_PER_HOUR=20                             # sessions per IP per hour
# MAX_SESSION_SECONDS=1200                       # hard cap per session

# --- Phone-in practice (optional): npm run phone -----------------------------
# PUBLIC_URL=https://your-app.onrender.com       # AssemblyAI calls the phone tools here
# PHONE_TOOL_SECRET=                              # long random string; also set on the server
# PHONE_NUMBER=+15551234567                       # shown to students on the phone-in screen
# PHONE_AGENT_ID=                                 # printed by the first run
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+15551234567                # a number you own in Twilio, E.164
# TWILIO_TRUNK_DOMAIN=vivavoice-yourname.pstn.twilio.com
