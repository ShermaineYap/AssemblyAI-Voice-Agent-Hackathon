# Copy to .env and fill in. .env is gitignored and never reaches the browser.
# https://www.assemblyai.com/dashboard/api-keys
ASSEMBLYAI_API_KEY=

# Optional
# PORT=3000
# PUBLIC_ORIGIN=https://your-app.onrender.com   # only this origin may mint tokens
# TOKENS_PER_HOUR=20                             # sessions per IP per hour
# MAX_SESSION_SECONDS=1200                       # hard cap per session
